{
  "name": "product-image-discovery-admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -r ./scripts/no-net-use.cjs ./node_modules/vite/bin/vite.js",
    "build": "node -r ./scripts/no-net-use.cjs ./node_modules/vite/bin/vite.js build",
    "test": "node -r ./scripts/no-net-use.cjs ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node -r ./scripts/no-net-use.cjs ./node_modules/vitest/vitest.mjs",
    "e2e": "npm run build && node scripts/prepare-e2e.mjs && playwright test",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "laravel-vite-plugin": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.0.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "jsdom": "^25.0.1",
    "vitest": "^4.1.5"
  }
}
