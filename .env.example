APP_NAME="Product Image Discovery Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

PID_ADMIN_ROUTE_PREFIX=admin/product-image-discovery
PID_ADMIN_ROUTE_MIDDLEWARE=web,auth
PID_ADMIN_DEBUG_RUN_MIDDLEWARE=auth

PRODUCT_IMAGE_DISCOVERY_ROUTE_PREFIX=api/product-image-discovery
PRODUCT_IMAGE_DISCOVERY_ROUTE_MIDDLEWARE=api,auth:sanctum
PRODUCT_IMAGE_DISCOVERY_STORAGE_DISK=local
PRODUCT_IMAGE_DISCOVERY_DEBUG_STOP_ON_FIRST_GOOD=true
PRODUCT_IMAGE_DISCOVERY_DEBUG_GOOD_SCORE_THRESHOLD=65
# Rejected runs search again with the next query family (ean, supplier_sku, model_code, description).
PRODUCT_IMAGE_DISCOVERY_SEARCH_ESCALATION=true
PRODUCT_IMAGE_DISCOVERY_SEARCH_MAX_STEPS=4
# Queue routing: one queue for every stage, or override single stages (see README "Queues").
# PRODUCT_IMAGE_DISCOVERY_QUEUE=default
# PRODUCT_IMAGE_DISCOVERY_QUEUE_SEARCH=image-discovery-api
# PRODUCT_IMAGE_DISCOVERY_QUEUE_VERIFY=image-discovery-api
# PRICE_INTELLIGENCE_QUEUE=default

PRODUCT_IMAGE_DISCOVERY_AI_ENABLED=false
PRODUCT_IMAGE_DISCOVERY_AI_PROVIDER=anthropic
PRODUCT_IMAGE_DISCOVERY_AI_TIMEOUT=45
PRODUCT_IMAGE_DISCOVERY_AI_FAIL_SILENTLY=true
PRODUCT_IMAGE_DISCOVERY_AI_ATTACH_REMOTE_IMAGE=false
PRODUCT_IMAGE_DISCOVERY_AI_VISION_MODEL=
PRODUCT_IMAGE_DISCOVERY_AI_DESCRIPTION_MODEL=

OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_URL=https://api.anthropic.com/v1
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1
REGOLO_API_KEY=
REGOLO_URL=https://api.regolo.ai/v1

# Signed completion callbacks (see README "Completion Callbacks"). JSON object host => secret:
# it is also the allow-list of callback_url hosts (https only). Empty = callback_url refused (422).
# PRODUCT_FINDER_CALLBACK_SECRETS={"gescat.example.com":"<same value as the tenant's AI_ENRICHMENT_PRODUCT_FINDER_CALLBACK_SECRET>"}
# PRODUCT_FINDER_CALLBACK_TIMEOUT=10
# PRODUCT_FINDER_CALLBACK_QUEUE=
# PRODUCT_FINDER_CALLBACK_ATTRIBUTES_WAIT_MINUTES=30

# Price intelligence panel (/admin/price-intelligence, see README)
# PRICE_INTELLIGENCE_ADMIN_TENANT=gescat
# PRICE_INTELLIGENCE_ADMIN_REALTIME=polling
# SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:8000

# Price intelligence LLM (fake = no external calls)
PI_LLM_DRIVER=fake
# PI_LLM_PROVIDER=regolo
# PI_LLM_MODEL=
# PI_LLM_TIMEOUT=60
# Category attributes: LLM step for wanted_attributes (needs a real PI_LLM_DRIVER and a worker on the "ai" queue)
# PI_ATTRIBUTE_EXTRACTION_ENABLED=false
# PI_ATTRIBUTE_EXTRACTION_MAX_TEXT_CHARS=12000
